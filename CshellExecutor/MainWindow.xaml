<Window x:Class="CshellExecutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSHELL EXECUTOR V1.0" Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#12121B" CornerRadius="15" BorderBrush="#2D2D3F" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            
            <!-- Top Bar -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="15,0">
                <Ellipse Width="12" Height="12" Fill="#FF5F56" Margin="0,0,8,0"/>
                <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="0,0,8,0"/>
                <Ellipse Width="12" Height="12" Fill="#27C93F"/>
                <TextBlock Text="CSHELL EXECUTOR" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0"/>
            </StackPanel>

            <!-- Editor Area -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="ScriptEditor" Background="#0D0D14" Foreground="#D4D4D4" 
                         BorderThickness="0" Padding="10" FontFamily="Consolas" FontSize="14"
                         AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"/>
                
                <Border Grid.Column="1" Background="#1A1A27" Margin="5,0,0,0" CornerRadius="8">
                    <StackPanel Margin="10">
                        <TextBlock Text="SCRIPT HUB" Foreground="#5064FF" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content="Auto Farm" Style="{StaticResource ModernBtn}"/>
                        <Button Content="Auto Raid" Style="{StaticResource ModernBtn}"/>
                        <Button Content="Bounty Hunter" Style="{StaticResource ModernBtn}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Bar -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,15,0">
                <Button Content="EXECUTE" x:Name="ExecBtn" Click="ExecBtn_Click" Width="100" Height="30" Margin="5" Style="{StaticResource ActionBtn}"/>
                <Button Content="INJECT" x:Name="InjectBtn" Click="InjectBtn_Click" Width="100" Height="30" Margin="5" Style="{StaticResource ActionBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
